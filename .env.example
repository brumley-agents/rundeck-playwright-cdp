# ============================================================================
# Rundeck Playwright CDP — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the values for your environment.
#
#   Copy-Item .env.example .env
#
# Lines starting with # are comments. Blank values use built-in defaults.
# ============================================================================

# --- REQUIRED ---------------------------------------------------------------
# These two must be set or the tool will not run.

# Base URL of your Rundeck instance (no trailing slash)
RUNDECK_BASE_URL=https://rundeck.example.com

# A relative path on Rundeck used to verify your session is authenticated.
# This is checked by the smoke test (npm run rundeck:open).
RUNDECK_TARGET_PATH=/project/example/jobs

# --- JOB --------------------------------------------------------------------

# Path to the Acloud-Get-Account-Details-SUPPORT job.
# Default is the standard UiPath job UUID — only change if your Rundeck uses a
# different job path.
RUNDECK_ACLOUD_JOB_PATH=/project/UiPath/job/show/ee31ce10-2b66-48a5-97c6-b88eb1364987

# --- JOB INPUTS (per-run) ---------------------------------------------------
# Set these before each run, or pass them as environment variables in PowerShell:
#   $env:RUNDECK_CLOUD_ORG = "https://cloud.uipath.com/adapthealth"
#   $env:RUNDECK_TICKET_NUMBER = "02830062"
#
# Full cloud URLs are automatically normalized to the org slug.

RUNDECK_CLOUD_ORG=
RUNDECK_TICKET_NUMBER=

# --- BROWSER ----------------------------------------------------------------

# Which browser to use: "edge" or "chrome" (default: edge)
RUNDECK_BROWSER=edge

# CDP connection settings (defaults work for local usage)
RUNDECK_CDP_HOST=127.0.0.1
RUNDECK_CDP_PORT=9222

# Browser channel override (e.g., "canary", "beta"). Leave blank for stable.
RUNDECK_BROWSER_CHANNEL=

# Full path to browser executable. Leave blank to use the defaults below.
RUNDECK_BROWSER_EXECUTABLE_PATH=

# Default browser executable paths (Windows).
# Update these if your browser is installed in a non-standard location.
RUNDECK_EDGE_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
RUNDECK_CHROME_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Custom user-data directories. Leave blank to use the isolated auth/ profile.
# Setting these to your real profile is possible but fragile due to profile locking.
RUNDECK_EDGE_USER_DATA_DIR=
RUNDECK_CHROME_USER_DATA_DIR=

# Browser profile directory name inside the user-data dir (default: Default)
RUNDECK_BROWSER_PROFILE_DIRECTORY=Default

# --- DEBUGGING --------------------------------------------------------------

# Comma-separated list of pause points for headed debugging.
# Valid values: before-run, after-run, execution-page, output-page
# Example: RUNDECK_DEBUG_PAUSE_POINTS=before-run,output-page
RUNDECK_DEBUG_PAUSE_POINTS=
